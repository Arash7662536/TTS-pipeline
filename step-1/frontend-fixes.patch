+                raise SystemExit(f"bad field bound {spec!r} -- "
+                                 f"{raw.strip()!r} is not a number")
+            lo, hi = bounds.get(name, (None, None))
+            bounds[name] = (v, hi) if idx == 0 else (lo, v)
+    return bounds
