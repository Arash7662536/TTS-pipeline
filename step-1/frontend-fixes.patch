+def _parse_bounds(min_specs, max_specs):
+    """`["mos_ovr=3.5"]`, `["wer=0.2"]` -> `{"mos_ovr": (3.5, None), ...}`."""
+    bounds = {}
+    for specs, idx in ((min_specs or [], 0), (max_specs or [], 1)):
+        for spec in specs:
+            name, sep, raw = spec.partition("=")
