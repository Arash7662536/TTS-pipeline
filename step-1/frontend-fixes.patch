+    return {"n": n, "min": round(v[0], 4), "p10": q(0.10), "p25": q(0.25),
+            "median": q(0.50), "p75": q(0.75), "p90": q(0.90),
+            "max": round(v[-1], 4),
+            "mean": round(sum(v) / n, 4)}
